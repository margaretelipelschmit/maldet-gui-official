# Runtime/operational state for a local installed instance living alongside
# this source checkout (the worktree root mirrors /usr/local/maldetect).
# These are generated by install.sh / maldet at runtime and must never be
# committed: they can contain live credentials (SMTP, Telegram, GUI auth),
# session data, and per-host operational state.
/VERSION
/VERSION.hash
/clean/
/conf.maldet
/conf.maldet.hookscan.default
/cron/
/event_log
/gui.auth
/hookscan.sh
/ignore_file_ext
/ignore_inotify
/ignore_paths
/ignore_sigs
/internals/
/logrotate.maldet
/logs
/maldet
/maldet-sshfs-scan
/maldet.1.gz
/monitor_paths
/quarantine/
/service/
/sess/
/sigs/
/sigs.old/
/tmp/

# Python bytecode caches must never be committed.
__pycache__/
*.pyc
